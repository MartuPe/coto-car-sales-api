<Project>
  <!-- Configuración común a todos los proyectos de la solución. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Genera el XML de los comentarios /// para que Swagger muestre la descripción de cada servicio.
         CS1591 (miembro público sin comentario) se omite: se documenta lo que aporta, no cada propiedad. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
</Project>
